<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="GameOverContainer" style="flex-grow: 1; background-color: rgb(5, 5, 8); display: none;">
        <ui:VisualElement style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(30, 30, 40, 0.4);"/>
        <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
            
            <ui:Label name="GameOverTitle" text="GAME OVER" style="font-size: 86px; -unity-text-align: center; margin-bottom: 60px; -unity-font-style: bold; letter-spacing: 20px; color: rgb(150, 110, 110);"/>
            
            <ui:VisualElement style="width: 300px;">
                <ui:Button name="PlayAgainButton" text="> TRY AGAIN" style="font-size: 24px; padding: 12px; margin-bottom: 10px; background-color: rgba(20, 20, 25, 0.95); color: rgb(160, 160, 180); border-width: 0;"/>
                <ui:Button name="MainMenuButton" text="[ MAIN MENU ]" style="font-size: 20px; padding: 10px; background-color: rgba(18, 18, 22, 0.95); color: rgb(140, 140, 160); border-width: 0;"/>
            </ui:VisualElement>
            
            <ui:Label text="there is no turning back..." style="position: absolute; bottom: 20px; right: 20px; color: rgba(150, 150, 170, 0.4); font-size: 12px; font-style: italic;"/>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>