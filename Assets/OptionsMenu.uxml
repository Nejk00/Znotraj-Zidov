<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="OptionsMenuContainer" style="flex-grow: 1; background-color: rgb(5, 5, 8);">
        <ui:VisualElement style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(30, 30, 40, 0.85);"/>
        <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
            <ui:Label name="OptionsTitle" text="// SETTINGS CONFIG //" style="font-size: 42px; -unity-text-align: center; color: rgb(130, 130, 150); margin-bottom: 40px; -unity-font-style: bold; letter-spacing: 8px;"/>
            <ui:VisualElement style="width: 550px; background-color: rgba(10, 10, 15, 0.9); padding: 30px; border-width: 1px; border-color: rgba(80, 80, 100, 0.5);">
                
                <!-- CONTROLS SECTION -->
                <ui:Label text="&gt; CONTROLS" style="font-size: 18px; color: rgb(140, 140, 160); margin-bottom: 15px; letter-spacing: 2px;"/>
                <ui:VisualElement style="flex-direction: row; margin-bottom: 25px; align-items: center;">
                    <ui:Label text="MOUSE SENSITIVITY" style="width: 150px; font-size: 16px; color: rgb(120, 120, 140);"/>
                    <ui:Slider name="MouseSensitivitySlider" low-value="0" high-value="100" value="50" style="flex-grow: 1; margin-right: 15px;"/>
                    <ui:Label name="MouseSensitivityValue" text="100%" style="width: 50px; font-size: 16px; color: rgb(160, 160, 180);"/>
                </ui:VisualElement>
                
                <!-- SEPARATOR -->
                <ui:VisualElement style="height: 1px; background-color: rgba(80, 80, 100, 0.5); margin: 10px 0 20px 0;"/>
                
                <!-- AUDIO SECTION -->
                <ui:Label text="&gt; AUDIO" style="font-size: 18px; color: rgb(140, 140, 160); margin-bottom: 15px; letter-spacing: 2px;"/>
                <ui:VisualElement style="flex-direction: row; margin-bottom: 15px; align-items: center;">
                    <ui:Label text="MASTER VOLUME" style="width: 150px; font-size: 16px; color: rgb(120, 120, 140);"/>
                    <ui:Slider name="MasterVolumeSlider" low-value="0" high-value="100" value="80" style="flex-grow: 1; margin-right: 15px;"/>
                    <ui:Label name="MasterVolumeValue" text="80%" style="width: 50px; font-size: 16px; color: rgb(160, 160, 180);"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; margin-bottom: 30px; align-items: center;">
                    <ui:Label text="SFX VOLUME" style="width: 150px; font-size: 16px; color: rgb(120, 120, 140);"/>
                    <ui:Slider name="SFXVolumeSlider" low-value="0" high-value="100" value="80" style="flex-grow: 1; margin-right: 15px;"/>
                    <ui:Label name="SFXVolumeValue" text="80%" style="width: 50px; font-size: 16px; color: rgb(160, 160, 180);"/>
                </ui:VisualElement>
                
                <!-- BUTTONS -->
                <ui:VisualElement style="flex-direction: row; margin-top: 10px; justify-content: space-between;">
                    <ui:Button name="BackButton" text="{ BACK }" style="flex-grow: 1; margin-left: 10px; font-size: 20px; padding: 12px; background-color: rgba(20, 20, 25, 0.95); color: rgb(140, 140, 160); border-width: 0;"/>
                </ui:VisualElement>
                <ui:Label text="calibrate your horror experience..." style="margin-top: 20px; color: rgba(150, 150, 170, 0.3); font-size: 11px; -unity-text-align: center; font-style: italic;"/>
                
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>