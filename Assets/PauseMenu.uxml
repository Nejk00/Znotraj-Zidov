<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <!-- PAUSE MENU - Matching the main menu theme -->
    <ui:VisualElement name="PauseMenuContainer" style="flex-grow: 1; background-color: rgb(5, 5, 8);">
        <!-- Dark overlay with slightly different opacity to indicate paused state -->
        <ui:VisualElement style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(30, 30, 40, 0.7);"/>
        
        <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
            <!-- "PAUSED" label instead of game title, following same style -->
            <ui:Label name="PausedLabel" text="|| PAUSED" style="font-size: 52px; -unity-text-align: center; color: rgb(150, 150, 170); margin-bottom: 60px; -unity-font-style: bold; opacity: 0.9; letter-spacing: 8px;"/>
            
            <ui:VisualElement style="width: 380px;">
                <!-- Resume button - styled like main menu's ENTER button -->
                <ui:Button name="ResumeButton" text="&gt; RESUME" style="font-size: 26px; padding: 14px; margin-bottom: 10px; background-color: rgba(20, 20, 25, 0.95); color: rgb(160, 160, 180); border-width: 0;"/>
                
                <!-- Options button - identical style to main menu -->
                <ui:Button name="OptionsButton" text="[ OPTIONS ]" style="font-size: 22px; padding: 10px; margin-bottom: 10px; background-color: rgba(18, 18, 22, 0.95); color: rgb(140, 140, 160); border-width: 0;"/>
                
                <!-- Main Menu button - new for pause menu -->
                <ui:Button name="MainMenuButton" text="{ MAIN MENU }" style="font-size: 22px; padding: 10px; margin-bottom: 10px; background-color: rgba(18, 18, 22, 0.95); color: rgb(140, 140, 160); border-width: 0;"/>
                
                <!-- Quit button - matches main menu's exit style -->
                <ui:Button name="QuitButton" text="[ EXIT ]" style="font-size: 22px; padding: 10px; background-color: rgba(22, 18, 20, 0.95); color: rgb(150, 120, 120); border-width: 0;"/>
            </ui:VisualElement>
            
            <!-- Small hint text showing how to unpause -->
            <ui:Label text="press [ESC] to resume..." style="position: absolute; bottom: 20px; right: 20px; color: rgba(150, 150, 170, 0.35); font-size: 11px; font-style: italic;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>